PORT=4000

# MySQL connection. Either set DATABASE_URL (as given by hosted MySQL providers) ...
# DATABASE_URL=mysql://user:password@host:3306/binsight
# ... or the individual settings below. DATABASE_URL takes precedence.
DB_HOST=localhost
DB_PORT=3306
DB_USER=binsight
DB_PASSWORD=binsight
DB_NAME=binsight
# Set to true for hosted MySQL that requires TLS (Aiven, TiDB Cloud, PlanetScale, ...).
DB_SSL=false

# Data store: mysql (default) or memory (built-in sample data, no database needed).
# On Vercel, memory is used automatically when no database is configured.
# DATA_STORE=memory

# Optional: URL of the Python image-assessment service (POST /assess).
# Leave empty to use the built-in rule-based stand-in.
AI_SERVICE_URL=
